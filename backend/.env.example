# Career DNA — Backend Environment Variables
# Copy this file to .env (locally) and set real values.
# On Render, set these in: Dashboard → Service → Environment

# Flask session signing key — use a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# (Optional) Gemini AI API key, if AI chat is upgraded to use the Gemini API.
# NEVER put this value in any frontend file or Vercel env var.
# GEMINI_API_KEY=
