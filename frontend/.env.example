# Career DNA — Frontend Environment Variables (Vite)
# Copy this file to .env.local for local development.
# On Vercel, set these in: Project → Settings → Environment Variables

# Public Render backend URL — safe to expose (it's just a URL, not a secret).
# Vite replaces import.meta.env.VITE_API_BASE_URL at build time.
VITE_API_BASE_URL=https://career-dna-0ull.onrender.com

# !! NEVER put Gemini API keys or any other secrets here !!
# VITE_* variables are embedded in the browser JavaScript bundle and are
# publicly visible. Secrets must stay on the Render backend only.
